<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="FrameLayout 실습"
        android:textColor="#8BC34A"
        android:textSize="20sp"
        android:textStyle="bold|italic" />

    <!-- 윗줄: [캐릭터(프레임 레이아웃)] [드레스1, 드레스2] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <!-- 프레임 레이아웃: 몸 위에 드레스 → 목걸이 → 왕관 순서로 겹침
             (나중에 쓴 위젯이 위에 올라옴) -->
        <FrameLayout
            android:layout_width="159dp"
            android:layout_height="274dp">

            <ImageView
                android:id="@+id/imageViewBody"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/body" />

            <ImageView
                android:id="@+id/imageViewObjDress"
                android:layout_width="156dp"
                android:layout_height="173dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="101dp"
                android:scaleType="fitXY"
                android:src="@drawable/dress1"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imageViewObjNecklace"
                android:layout_width="156dp"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="98dp"
                android:src="@drawable/necklace1"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/imageViewObjCrown"
                android:layout_width="156dp"
                android:layout_height="33dp"
                android:layout_gravity="top|center_horizontal"
                android:src="@drawable/crown1"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="274dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewDress1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:padding="4dp"
                android:src="@drawable/dress1" />

            <ImageView
                android:id="@+id/imageViewDress2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:padding="4dp"
                android:src="@drawable/dress2" />
        </LinearLayout>
    </LinearLayout>

    <!-- 아랫줄: [왕관1 왕관2 / 목걸이1 목걸이2] [드레스3] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="159dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewCrown1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown1" />

                <ImageView
                    android:id="@+id/imageViewCrown2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewNecklace1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace1" />

                <ImageView
                    android:id="@+id/imageViewNecklace2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace2" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewDress3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="onClickChoice"
            android:padding="4dp"
            android:src="@drawable/dress3" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:onClick="onClickReset"
        android:text="다시하기"
        app:backgroundTint="#26C6DA" />

</LinearLayout>