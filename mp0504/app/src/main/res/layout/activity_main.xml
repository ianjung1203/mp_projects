<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="ToggleButton 실습"
        android:textColor="#8BC34A"
        android:textSize="20sp"
        android:textStyle="bold|italic" />

    <!-- 방 배경 위에 조명과 벽 스위치를 겹쳐서 배치 -->
    <FrameLayout
        android:layout_width="343dp"
        android:layout_height="306dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/imageViewRoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg1" />

        <!-- 천장에 매달린 조명 3개 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="30dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageViewLight1"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/light11" />

            <ImageView
                android:id="@+id/imageViewLight2"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/light12" />

            <ImageView
                android:id="@+id/imageViewLight3"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/light13" />

        </LinearLayout>

        <!-- 벽면 ON/OFF 스위치 = 토글 버튼 (글자 없이 배경 그림만 사용) -->
        <ToggleButton
            android:id="@+id/toggleButtonLight"
            android:layout_width="30dp"
            android:layout_height="41dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/off"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text=""
            android:textOff=""
            android:textOn="" />
    </FrameLayout>

</LinearLayout>